# Variables de Entorno para Producción en Vercel (Environment Variables)

# 1. Supabase (Base de Datos)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# 2. IA / LLM (Claude / GPT)
ANTHROPIC_API_KEY=sk-ant-tu-api-key-de-anthropic
OPENAI_API_KEY=sk-proj-tu-api-key-de-openai
SYSTEM_PROMPT="Eres un asistente virtual profesional de atención al cliente por WhatsApp."
TEMPERATURE=0.7

# 3. Evolution API / Baileys URL Pública
EVOLUTION_API_URL=https://tu-instancia-evolution-o-tunel.loca.lt
EVOLUTION_API_KEY=tu_global_api_key_secreta
EVOLUTION_INSTANCE_NAME=default

# 4. Webhook URL en Vercel
WEBHOOK_URL=https://tu-agente-whatsapp.vercel.app/api/webhook
